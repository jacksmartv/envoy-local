# Copy to .env to override defaults. Every value is optional; the defaults
# shown here are the ones compose.yaml uses when a variable is unset.
# Never put secrets or production credentials in this file.

# Base image tag for envoy/Dockerfile. Pin to an exact version (never `latest`).
# Ideally match the Envoy version that your production Envoy Gateway release
# deploys. After changing it: ./scripts/validate.sh && docker compose up -d --build
ENVOY_VERSION=v1.40.2

# Host port for the HTTP listener.
ENVOY_HTTP_PORT=8080

# Host interface to bind. 127.0.0.1 = this machine only.
# Use 0.0.0.0 only if other devices on your network must reach the proxy.
ENVOY_BIND_ADDRESS=127.0.0.1

# Envoy application log level: trace|debug|info|warning|error|critical|off
ENVOY_LOG_LEVEL=info

# true = the entrypoint prints envoy.yaml to the logs at startup
# (like the reference example). Then: docker compose up -d
ENVOY_DUMP_CONFIG=false

# Host port for the OPT-IN admin access (compose.admin.yaml only; always 127.0.0.1).
# ENVOY_ADMIN_PORT=9901

# Routes web UI (always published on 127.0.0.1 only).
ROUTES_UI_PORT=8090
# Linux only: uid/gid allowed to write ./envoy on the host (your `id -u` / `id -g`).
# Docker Desktop doesn't need this.
# ROUTES_UI_UID=1000
# ROUTES_UI_GID=1000

# --- Integration with an existing app network (see compose.integration.example.yaml) ---
# APP_NETWORK=myapp_default
# COMPOSE_FILE=compose.yaml:compose.integration.yaml
