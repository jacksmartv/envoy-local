# --- Local configuration (per developer; never commit) ---
.env
.env.*
!.env.example
# Generated from compose.integration.example.yaml with your app's network
compose.integration.yaml
compose.override.yaml

# --- Local TLS material: never commit private keys or certificates ---
envoy/certs/
*.key
*.pem
*.crt
*.p12
*.pfx

# --- Python (routes-ui/server.py, examples/app-one/server.py run locally) ---
__pycache__/
*.py[cod]

# --- Logs and backups ---
*.log
*.bak
*.orig
*.tmp

# --- Editors and OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
